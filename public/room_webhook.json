    {
      "parameters": {
        "jsCode": "// Function Node - \"Extract Stream Key\"\nconst message = items[0].json.message;\nconst text = message.text;\nconst chatId = message.chat.id;\n\n// Check if command has a parameter\nconst streamKey = text.split('/setstream ')[1]?.trim();\n\nif (!streamKey) {\n  return {\n    json: {\n      chatId: chatId,\n      error: true,\n      message: '❌ Please provide a stream key.\\nUsage: /setstream YOUR_STREAM_KEY'\n    }\n  }\n}\n\nreturn {\n  json: {\n    chatId: chatId,\n    userId: message.from.id,\n    streamKey: streamKey,\n    timestamp: new Date().toISOString(),\n    userName: `${message.from.first_name} ${message.from.last_name}`.trim()\n  }\n}"
      },
